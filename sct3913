lnipterimaoke2	lmetodbyr       REPLACE_IF cmetod206_2
cbyr765		lmetodbyr       DO_CALC_IF cmetod765
cbyrlama	lmetodbyr       DO_CALC_IF cmetodlama
cbyrlama2	lmetodbyr       DO_CALC_IF cmetodlama2
cbyr765		lmetodbyr       DO_CALC_IF cmetodlama3
cbyr203_1	lmetodbyr       DO_CALC_IF cmetodlama4
cbyrlama3	lmetodbyr       DO_CALC_IF cmetodlama5
cbyrlama4	lmetodbyr       DO_CALC_IF cmetodlama6
cbyr204		lmetodbyr	DO_CALC_IF cmetod204
cbyr305		lmetodbyr	DO_CALC_IF cmetod305

MAP(maddaktcekbyrklik)
lcekbyrklik	aktdata		REPLACE
anhnobuk	aktkode		REPLACE
lcekbyrklik	akttype		REPLACE
g_tgltrn	akttgl		REPLACE
