SUBFILE(trans)
SFL_LINES(10)
/*SFL_COND ckond1*/
SFL_SELECT cbyr_ang
SFL_SORT_BY_FIELD anhke
SFL_SORT_UPDOWN DOWN
SFL_TARGET
anhbukotourt	ftmnofak

MAP(mmapmap0)
	lpikplg		lpikplg		REPLACE_IF cjoinpik
	lcustomerName	lcustomerName	REPLACE_IF cjoinpsm
	lNoMesin	lNoMesin	REPLACE_IF cjoinmotor
	lNamaMotor	lNamaMotor	REPLACE_IF cjoinbtm
	lpengambilplat	lpengambilplat	REPLACE_IF cjoinplat
	lcabtwr		lcabtwr		REPLACE_IF cjoincab
	longitude	longitude	REPLACE_IF cjoinlonglat
DEBUG	ldum		ldum		REPLACE

CALCS()
canhsisa	lpiklama - anhke
canhtotden	anhbyrden + anhbyradm
canhtotbyr	lpikangbl + anhbyrden + anhbyradm
cproc		lnobuk2 != anhnobuk
cjoinbkmbyr	djoinbkmbyr==1
cbankmetod0	DO_LIB ap_amstr(anhnobyr,lhuruf1,lhuruf2,&lnipterimaoke);
cbankmetod1	DO_LIB ap_amstr(anhnobyr,lhuruf1,lhuruf3,&lnipterimaoke2);
cbankmetod2	DO_LIB ap_amstr(anhnobyr,lhuruf1,lhuruf4,&lnipterimaoke3);
cmetod203_1	lscrmetod=="203" && djoinpsibyr == 1
cmetod203_2	lscrmetod=="203" && djoinpsibyr == 0 && lnipterima != BLANKS
cmetod203_3	lscrmetod=="203" && djoinpsibyr == 0 && lnipterima == BLANKS
cmetod206_1	lscrmetod=="206" && lnipterimaoke == "PA"
cmetod206_2	lscrmetod=="206" && lnipterimaoke != "PA"
cmetod765	lscrmetod=="765"
cmetod204	lscrmetod=="204"
cmetod305	lscrmetod=="305"
cmetodlama	djoinbkmbyr==0 && lnipterimaoke3 == "ALFA"
cmetodlama2	djoinbkmbyr==0 && lnipterimaoke3 == "INDO"
cmetodlama3	djoinbkmbyr==0 && lnipterimaoke == "TY"
cmetodlama4	djoinbkmbyr==0 && lnipterimaoke == "BX"
cmetodlama5	djoinbkmbyr==0 && lnipterimaoke == "RS"
cmetodlama6	djoinbkmbyr==0 && lnipterimaoke2 == "POS"
cbyr203_1	"KASIR"
cbyr203_3	"POTONG GAJI"
cbyr206		"TRANSFER"
cbyr765		"KOLEKTOR"
cbyr204		"PELUNASAN"
cbyr305		"PENCAIRAN TOPUP"
cbyrlama	"ALFAMART/ALFAMIDI"
cbyrlama2	"INDOMARET"
cbyrlama3	"RESTRUKTUR KASIR"
cbyrlama4	"KANTORPOS"
cdjointelat	djointelat == 1

MAP(mmapmap)
lpiklama	lpiklama	REPLACE_IF cjoinpik
lpikangbl	lpikangbl	REPLACE_IF cjoinpik
canhsisa	lanhsisa	DO_CALC
canhtotden	lanhtotden	DO_CALC
canhtotbyr	lanhtotbyr	DO_CALC
cblanks		lscrmetod       DO_CALC
cblanks		lmetodbyr       DO_CALC
cblanks		lnipterima      DO_CALC
cblanks		lnipterimaoke   DO_CALC
cblanks		lnipterimaoke2  DO_CALC
cblanks		lnipterimaoke3  DO_CALC
cbankmetod0	lnipterimaoke   DO_CALC
cbankmetod1	lnipterimaoke2  DO_CALC
cbankmetod2	lnipterimaoke3  DO_CALC
lscrmetod	lscrmetod       REPLACE_IF cjoinbkmbyr
lnipterima	lnipterima      REPLACE_IF cjoinbkmbyr
cbyr203_1	lmetodbyr       DO_CALC_IF cmetod203_1
lnipterima	lmetodbyr       REPLACE_IF cmetod203_2
cbyr203_3	lmetodbyr       DO_CALC_IF cmetod203_3
cbyr206		lmetodbyr       DO_CALC_IF cmetod206_1
lnipterimaoke2	lmetodbyr       REPLACE_IF cmetod206_2
cbyr765		lmetodbyr       DO_CALC_IF cmetod765
cbyrlama	lmetodbyr       DO_CALC_IF cmetodlama
cbyrlama2	lmetodbyr       DO_CALC_IF cmetodlama2
cbyr765		lmetodbyr       DO_CALC_IF cmetodlama3
cbyr203_1	lmetodbyr       DO_CALC_IF cmetodlama4
cbyrlama3	lmetodbyr       DO_CALC_IF cmetodlama5
cbyrlama4	lmetodbyr       DO_CALC_IF cmetodlama6
cbyr204		lmetodbyr	DO_CALC_IF cmetod204
cbyr305		lmetodbyr	DO_CALC_IF cmetod305
/* ======== TAMBAHAN ======== */
ltgljtp		ltgljtp		REPLACE_IF cdjointelat

MAP(maddaktcekbyrklik)
lcekbyrklik	aktdata		REPLACE
anhnobuk	aktkode		REPLACE
lcekbyrklik	akttype		REPLACE
g_tgltrn	akttgl		REPLACE
