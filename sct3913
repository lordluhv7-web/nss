SPCALCS(spmaster)
	DO_LIB			ap_dbclc(DNAME dmapmap0,DCOMMAND MAPMAP,DMAP mmapmap0);
	DO_LIB_IF ckond1	ap_jsnmt(lrequestreply,lmsttitle,lmstlabel,lmstfields);
	DO_LIB_IF ckond2	ap_jsnmt(lrequestreply,lmsttitle,lmstlabel,lmstfields2);
	DO_LIB_IF ckond3	ap_jsnmt(lrequestreply,lmsttitle,lmstlabel,lmstfields3);
	DO_LIB_IF ckond4	ap_jsnmt(lrequestreply,lmsttitle,lmstlabel,lmstfields4);

SPCALCS(sptrans)
	DO_LIB			ap_dbclc(DNAME dmapmap,DCOMMAND MAPMAP,DMAP mmapmap);
	/*DO_LIB		ap_snjsp(lurl,lreturnlabel,lexpectedreturnvalue);*/
	DO_LIB			ap_jsndt(ldettitle,ldetlabel,ldetfields);
	DO_LIB_IF cproc		ap_dbclc(DNAME daddaktcekangklik,DCOMMAND ADD,DFILE akt,DMAP maddaktcekbyrklik);
	DO_LIB			ap_dbclc(DNAME dmapend,DCOMMAND MAPMAP,DMAP mmapend);

POSTING(master)
   PST_COMMAND		spmaster

POSTING(trans)
   PST_COMMAND		sptrans

