bkmkode2        lnipterima      REPLACE

DBCALCS(djoinbkmbyr)
        DBC_COMMAND     JOIN
        DBC_TARGET      bkmbukidx 	anhnobyr
        DBC_MAP         mjoinbkmbyr

DBCALCS(djoinpsibyr)
        DBC_COMMAND     JOIN
        DBC_TARGET      psikodidx 	lnipterima

IMAGE(master) 
/--------------------------------------------------------\
| /----------------------------------------------------\ |
| |i.NoBuk   : ____________________                    | |
| \----------------------------------------------------/ |
\--------------------------------------------------------/

FIELDS(master)
   lNoFaktur            NONE           INPUTRI          1 

DEFAULTS(master)
lrequestreply	INIT	"reply"
lmstlabel       INIT    "Status"
lmstfields	INIT    "lstatus"
lmstfields2	INIT    "lstatus2"
lmstfields3	INIT    "lstatus3"
lmstfields4	INIT    "lstatus4"
lmsttitle       INIT    ""
l16		INIT	16
lDataDiterima	INIT	"Data Diterima"
lnamfil		INIT     {r_string1}
ldatetype 	INIT	1
lcekbyrklik	INIT	CEKBYRKLIK
lurl			INIT	"https://172.17.0.1/ksapisvr"
lreturnlabel          	INIT     "error"
lexpectedreturnvalue  	INIT     "false"

linplabels	INIT    "NoFaktur" 
linpfields	INIT    "ftmnofak"

linpmap		INIT	mmapftm  
lsavedata	INIT		 1
