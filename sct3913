lmstfields2	INIT    "lstatus2"
lmstfields3	INIT    "lstatus3"
lmstfields4	INIT    "lstatus4"
lmsttitle       INIT    ""
l16		INIT	16
lDataDiterima	INIT	"Data Diterima"
lnamfil		INIT    {r_string1}
ldatetype 	INIT	1
lcekbyrklik	INIT	CEKBYRKLIK
lurl			INIT	"https://172.17.0.1/ksapisvr"
