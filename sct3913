btmtypmtr2      lNamaMotor      REPLACE

DBCALCS(djoinbtm)
        DBC_COMMAND     JOIN
        DBC_TARGET      btmbukidx       lpiknobtm
        DBC_MAP         mjoinbtm

MAP(mjoinplat)
	tlmket		lpengambilplat	REPLACE
	tlmtgl2		ltglambilplat	REPLACE
	tlmcab		lcabangplat	REPLACE
	
DBCALCS(djoinplat)
	DBC_COMMAND	JOIN
	DBC_TARGET	tlmdataslsts	lMUTASISTNK ftmnofak
	DBC_MAP		mjoinplat

MAP(mjoincab)
	cabnama		lnamacabang	REPLACE
	cabalamat	lalamatcabang	REPLACE
	cabtwr		lcabtwr		REPLACE
DBCALCS(djoincab)
	DBC_COMMAND	JOIN
	DBC_TARGET	cabkodidx	lcabangplat
	DBC_MAP		mjoincab		

MAP(mjoinlonglat)
	tbddf1		longitude	REPLACE
	tbddf2		latitude	REPLACE
DBCALCS(djoinlonglat)
	DBC_COMMAND	JOIN
	DBC_TARGET	tbddtkodidx   tbddata lcabtwr
	DBC_MAP		mjoinlonglat

CALCS()
cbyr_ang	anhsts == "CLSD" && anhtype == "F"
cstatustelat		angsts == "OPEN" || angsts == "INPG"

DBCALCS(djoinanh)
	DBC_COMMAND	JOIN
	DBC_TARGET	anhbukotourt	ftmnofak
	DBC_SELECT	cbyr_ang

MAP(mjoinbkmbyr)
bkmscr          lscrmetod       REPLACE
bkmkode2        lnipterima      REPLACE

DBCALCS(djoinbkmbyr)
        DBC_COMMAND     JOIN
        DBC_TARGET      bkmbukidx 	anhnobyr
        DBC_MAP         mjoinbkmbyr

DBCALCS(djoinpsibyr)
        DBC_COMMAND     JOIN
        DBC_TARGET      psikodidx 	lnipterima

MAP(mjointelat)
        angtgljtp       ltgljtp    REPLACE
DBCALCS(djointelat)
        DBC_COMMAND     JOIN
        DBC_TARGET      angbukstsidx    piknobuk gv_ANG
        DBC_SELECT      cstatustelat
        DBC_MAP         mjointelat

