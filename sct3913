	DBC_COMMAND	JOIN
	DBC_TARGET	pikdatbukidx	gv_dtpiu ftmnofak
	DBC_MAP		mjoinpik

MAP(mjoinpsm)
	psmnama		lcustomerName	REPLACE
DBCALCS(djoinpsm)
	DBC_COMMAND	JOIN
	DBC_TARGET	psmktpidx	lpikplg
	DBC_MAP		mjoinpsm

MAP(mjoinmotor)
        ssunopol        lNoPol          REPLACE
        ssurangka       lNoRangka       REPLACE
        ssumesin        lNoMesin        REPLACE
	ssutglspes	lplatcompleted	REPLACE
DBCALCS(djoinmotor)
        DBC_COMMAND     JOIN
        DBC_TARGET      ssubuk2idx      piknobuk
        DBC_MAP         mjoinmotor

MAP(mjoinbtm)
