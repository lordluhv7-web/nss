gv_INPG		ftmsts		REPLACE
ftmnofak	lnobuk		REPLACE

HOOKS(master)
BEFORE_INPUT cur_field=lNoFaktur DO_LIB ap_rdjsn(lnamfil,linplabels,linpfields,linpmap,g_strksg,g_strksg,g_strksg,lsavedata);

CALCS()
ckond1		ftmnofak != BLANKS && djoinpik == 1 && djoinanh == 1
ckond2		ftmnofak != BLANKS && djoinpik == 1 && djoinanh == 0
ckond3		ftmnofak != BLANKS && djoinpik == 0
ckond4		ftmnofak == BLANKS
cjoinpik	ftmnofak != BLANKS && djoinpik == 1
cjoinpsm	ftmnofak != BLANKS && djoinpsm == 1
cjoinmotor	ftmnofak != BLANKS && djoinmotor == 1
cjoinbtm	ftmnofak != BLANKS && djoinbtm == 1
cjoinplat	ftmnofak != BLANKS && djoinplat == 1
cjoincab	ftmnofak != BLANKS && djoincab == 1
cjoinlonglat	ftmnofak != BLANKS && djoinlonglat == 1

IMAGE(trans)
|__________________|____________|__________|_________|

FIELD(trans)
anhnobuk	NOCHANGE				INPUTRI	1
anhtglbyr	PROTECT NOLIMIT {DD-MM-YYYY}		INPUTRI	2
anhsts		PROTECT					INPUTRI	3
anhdata		PROTECT					INPUTRI	4


DEFAULTS(trans)
