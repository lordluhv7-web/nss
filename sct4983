lperintahquery		INIT		"WITH 
  base AS (
    SELECT 
      MAX(piknobuk) as MAX_NOBUK, 
      MAX(pikoto) as MAX_OTO, 
      piksts, 
      piknobtm, 
      pikplg as KTP, 
      pikcab, 
      pikcabpiu, 
      pikdvs, 
      piktypjl, 
      MAX(piktglfak) as MAX_TGL 
    FROM 
      pik 
    WHERE 
      pikdata = 'DTPIU' 
      AND pikcab = {cabkode} 
      AND piktglfak BETWEEN {ltgl1} AND {ltgl2} 
      AND piksts NOT IN ('VOID', '') 
    GROUP BY 
      pikplg
  ), 
  data1 AS (
    SELECT 
      *, 
      (
        SELECT 
          pikoto 
        FROM 
          pik 
        WHERE 
          pikplg = ktp 
          AND piksts NOT IN ('VOID', '') 
          AND piktglfak <= base.MAX_TGL 
          AND pikoto != base.MAX_OTO 
        ORDER BY 
          piktglfak DESC 
        LIMIT 
          1
      ) AS FAKTUR_TERAKHIR, 
      CASE WHEN EXISTS (
        SELECT 
          1 
        FROM 
          pik 
        WHERE 
          pikplg = ktp 
          AND piksts NOT IN ('VOID', '') 
          AND piktglfak <= base.MAX_TGL 
          AND pikoto != base.MAX_OTO
      ) THEN 'RO' ELSE 'NEW' END AS STATUS_RO 
    FROM 
      base
  ), 
  data2 AS(
    SELECT 
      KTP, 
      STATUS_RO, 
      data1.pikdvs as LATEST_BISNIS, 
      data1.piktypjl as LATEST_TYPE_JUAL, 
      data1.MAX_TGL as LATEST_TGL, 
      pik_ro.pikdvs as PREVIOUS_BISNIS, 
      pik_ro.piktypjl as PREVIOUS_TYPE_JUAL, 
      pik_ro.piktglfak as PREVIOUS_TGL, 
      data1.pikcab as CABANG 
    FROM 
      data1 
      LEFT JOIN pik pik_ro ON pik_ro.pikoto = data1.FAKTUR_TERAKHIR 
      AND STATUS_RO = 'RO'
  ) 
SELECT 
  CABANG, 
  COUNT(data2.KTP) as TOTAL_KONSUMEN, 
  COUNT(
    IF(
      data2.STATUS_RO = 'RO', data2.KTP, 
      null
    )
  ) as RO_BY_KTP, 
  COUNT(
    IF(
      data2.LATEST_BISNIS = 'HMC' 
      AND data2.PREVIOUS_BISNIS = 'HMC', 
      data2.KTP, 
      null
    )
  ) as HMC_HMC, 
  COUNT(
    IF(
      data2.LATEST_BISNIS = 'HMC' 
      AND data2.PREVIOUS_BISNIS = 'M2W', 
      data2.KTP, 
      null
    )
  ) as HMC_M2W, 
  COUNT(
    IF(
      data2.LATEST_BISNIS = 'HMC' 
      AND data2.PREVIOUS_BISNIS = 'M4W', 
      data2.KTP, 
      null
    )
  ) as HMC_M4W, 
  COUNT(
    IF(
      data2.LATEST_BISNIS = 'HMC' 
      AND data2.PREVIOUS_BISNIS = 'MGA', 
      data2.KTP, 
      null
    )
  ) as HMC_GADAI, 
  COUNT(
    IF(
      data2.LATEST_BISNIS = 'M2W' 
      AND data2.PREVIOUS_BISNIS = 'M2W', 
      data2.KTP, 
      null
    )
  ) as M2W_M2W, 
