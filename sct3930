LOCAL
PGM_FIELDS
lstatus			STRING		61
lTipeRequest		STRING		21
lnamfil			STRING		31
lrequestreply		STRING		31
lmsttitle		STRING		31
ldettitle		STRING		31
linplabels		STRING		501
linpfields		STRING		801
linpmap			STRING		21
lsavedata		INT2		2
lmstlabel		STRING		100
lmstfields		STRING		100
ldetlabels		STRING		251
ldetfields		STRING		251
ldetnamamap		STRING		31
lversi			STRING		11
lketUpdate		STRING		100
lOPTKLIKNSS		STRING		11
lSYSTIME		TIME		4
lnobuk614		STRING		21
lnamamtr		STRING		31
lnomesin		STRING		21
lnopol			STRING		21
liddebitur		STRING		21
