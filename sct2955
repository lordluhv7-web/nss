cBLANKS		lnipSA		DO_CALC
cBLANKS		lnipSA2		DO_CALC
cBLANKS		lnip21sa	DO_CALC
cBLANKS		lnobuk198	DO_CALC
tbtkode		lnipPM		REPLACE
