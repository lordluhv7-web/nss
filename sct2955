IMAGE(transt)
/----------------t---------------------------------------------------\
|  i.Kode        | t.Ket                                             |
\----------------.---------------------------------------------------/

IMAGE(trans)
|_____ __________|___________________________________________________|

FIELD(trans)
tbtkode         PROTECT SCROLL          INPUTRI     1
tbtdf1         	PROTECT SCROLL          INPUTRI     2
tbttbdkode      NOCHANGE                INPUTRI     3

CALCS()
ccek198sa	tlmplg	== lnip21sa
                                                              
DBCALCS(djointkm198)                                                                         
    DBC_COMMAND     JOIN                                                               
    DBC_SELECT      ccek198sa 
    DBC_TARGET      tkmdatljltgl  lREVIEWIT lnip21pm ltgl2 

   	
DBCALCS(djoinabk198pm)                                                                         
    DBC_COMMAND     JOIN                                                               
    DBC_TARGET      abkdatstskym   lKUNCIABSEN gv_INPG lnip21pm l198 ltgl2 lnobuk198 

DBCALCS(djoinabk198sa)                                                                         
    DBC_COMMAND     JOIN                                                               
    DBC_TARGET      abkdatstskym   lKUNCIABSEN gv_INPG lnip21sa l198 ltgl2 lnobuk198 

DBCALCS(djoinabk198div)                                                                         
    DBC_COMMAND     JOIN                                                               
    DBC_TARGET      abkdatstskym   lKUNCIABSEN gv_INPG tbttbdkode l198 ltgl2 lnobuk198 


CALCS()
