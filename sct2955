cjoinabk198sa	djoinabk198sa == 0 && tbtdf2 != BLANKS
cjoinabk198div	djoinabk198div == 0
cceknip		tbtkettype != "PM" && tbtkettype != "GM"
cnipTnpPM	tbtkettype != "PM" && tbtkettype != "GM" && (tbtdf1 == BLANKS || tbtdf1 == 0)

SUBFILE(trans)
SFL_TITLE(transt)
SFL_LINES(10)
SFL_COND cpilok
SFL_TARGET
tbtdattypkod   gv_dttabel gv_dttabel21 gv_infoumum lSTRUKTURKPIIT


