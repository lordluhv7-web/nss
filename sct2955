cnobuk198pm	"RVIT" + THBLS(ltgl2)+ THBLS_DD(ltgl2) + STRIP(lnip21pm) 
cadasa		tbtdf2 != BLANKS
ctdkadasa	tbtdf2 == BLANKS

SUBFILE(trans2)
SFL_TITLE(trans2t)
SFL_LINES(10)
SFL_COND cpilokd
SFL_SELECT c196lwt
SFL_TARGET
tlmstsbbmcab   gv_INPG tbtkode

MAP(mapmap)
